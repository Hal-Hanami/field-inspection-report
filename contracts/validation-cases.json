{
  "description": "Validation outcomes that the web (src/domain) and the server (api/app/domain) must both produce. See DESIGN section 7.3. A case applies `patch` to `baseDraft` (check results are merged item by item) and validates it with the clock reading `now`, a wall-clock time in the users' zone.",
  "baseDraft": {
    "equipmentId": "TR-0142",
    "equipmentType": "transformer",
    "inspectedAt": "2026-09-23T09:30",
    "inspectorName": "Inspector A",
    "checks": {
      "appearance": "ok",
      "abnormalSound": "ok",
      "temperature": "ok",
      "corrosion": "ok",
      "surroundings": "ok"
    },
    "remarks": ""
  },
  "draftCases": [
    {
      "name": "the base draft is valid",
      "now": "2026-09-23T10:00",
      "patch": {},
      "expect": {
        "valid": true,
        "normalizedPatch": {}
      }
    },
    {
      "name": "equipment id is trimmed and upper-cased before it is checked",
      "now": "2026-09-23T10:00",
      "patch": {
        "equipmentId": "  tr-0142 "
      },
      "expect": {
        "valid": true,
        "normalizedPatch": {
          "equipmentId": "TR-0142"
        }
      }
    },
    {
      "name": "a missing equipment id is reported as missing, not as the wrong shape",
      "now": "2026-09-23T10:00",
      "patch": {
        "equipmentId": ""
      },
      "expect": {
        "valid": false,
        "errors": {
          "equipmentId": "errors.equipmentId.required"
        }
      }
    },
    {
      "name": "an equipment id of spaces only is missing",
      "now": "2026-09-23T10:00",
      "patch": {
        "equipmentId": "   "
      },
      "expect": {
        "valid": false,
        "errors": {
          "equipmentId": "errors.equipmentId.required"
        }
      }
    },
    {
      "name": "an equipment id of the wrong shape",
      "now": "2026-09-23T10:00",
      "patch": {
        "equipmentId": "TR142"
      },
      "expect": {
        "valid": false,
        "errors": {
          "equipmentId": "errors.equipmentId.format"
        }
      }
    },
    {
      "name": "full-width digits are not the ASCII digits the id is written in",
      "now": "2026-09-23T10:00",
      "patch": {
        "equipmentId": "TR-\uff10\uff11\uff14\uff12"
      },
      "expect": {
        "valid": false,
        "errors": {
          "equipmentId": "errors.equipmentId.format"
        }
      }
    },
    {
      "name": "an unselected equipment type",
      "now": "2026-09-23T10:00",
      "patch": {
        "equipmentType": ""
      },
      "expect": {
        "valid": false,
        "errors": {
          "equipmentType": "errors.equipmentType.required"
        }
      }
    },
    {
      "name": "an equipment type outside the list",
      "now": "2026-09-23T10:00",
      "patch": {
        "equipmentType": "boiler"
      },
      "expect": {
        "valid": false,
        "errors": {
          "equipmentType": "errors.equipmentType.required"
        }
      }
    },
    {
      "name": "a missing inspection time",
      "now": "2026-09-23T10:00",
      "patch": {
        "inspectedAt": ""
      },
      "expect": {
        "valid": false,
        "errors": {
          "inspectedAt": "errors.inspectedAt.required"
        }
      }
    },
