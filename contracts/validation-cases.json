        "inspectedAt": "2026-02-30T10:00"
      },
      "expect": {
        "valid": false,
        "errors": {
          "inspectedAt": "errors.inspectedAt.invalid"
        }
      }
    },
    {
      "name": "seconds are not part of the device format",
